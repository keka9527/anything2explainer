# Copy to .env. Never commit the real key.
TTS_ENGINE=volcengine
VOLCENGINE_TTS_API_KEY=replace_with_your_api_key
VOLCENGINE_TTS_SPEAKER=zh_female_vv_uranus_bigtts
VOLCENGINE_TTS_RESOURCE_ID=seed-tts-2.0
VOLCENGINE_TTS_SPEECH_RATE=0
VOLCENGINE_TTS_LOUDNESS_RATE=0
VOLCENGINE_TTS_PITCH=0
VOLCENGINE_ALIGN_MODEL=base

# Natural paragraph mode keeps only a tiny pause between blank-line paragraphs.
PARAGRAPH_GAP=6
CHAPTER_GAP=45
LEAD=40
TAIL=90
